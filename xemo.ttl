  rdf:type geo:Geometry ;
  geo:asWKT "POINT (13.37715 42.36059)"^^geo:wktLiteral ;
.
demo:SensorLocation1
  rdf:type geo:Geometry ;
  geo:asWKT "POINT (13.3434075780457 42.3672976787185)"^^geo:wktLiteral ;
.
demo:Sensor_Airnode_01
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Sensor ;
.
demo:Sensor_Airnode_02
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Sensor ;
.
demo:Sensor_Airnode_03
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Sensor ;
.
demo:Sensor_Airnode_Via_Amiternum
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Sensor ;
.
demo:Site_Station_01
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Platform ;
  geo:hasGeometry demo:SensorLocation1 ;
  sosa:hosts demo:Sensor_Airnode_01 ;
