# baseURI: https://example.org/xemo#
# prefix: xemo

@prefix : <https://example.org/xemo#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix demo: <https://example.org/xemo/demo#> .
@prefix dicp: <https://w3id.org/digitalconstruction/0.5/Processes> .
@prefix dtc: <https://dtc-ontology.cms.ed.tum.de/ontology/v2#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xemo: <https://example.org/xemo#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

geo:Geometry
  rdf:type owl:Class ;
  rdfs:subClassOf owl:Thing ;
  owl:equivalentClass [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass geo:wktLiteral ;
      owl:onProperty geo:asWKT ;
    ] ;
  owl:equivalentClass [
      rdf:type owl:Restriction ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass geo:wktLiteral ;
      owl:onProperty geo:asWKT ;
    ] ;
.
sosa:Platform
  rdf:type owl:Class ;
  rdfs:subClassOf geo:Feature ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass geo:Geometry ;
      owl:onProperty geo:hasGeometry ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass geo:Geometry ;
      owl:onProperty geo:hasGeometry ;
    ] ;
.
xemo:
  rdf:type owl:Ontology ;
.
xemo:AirPollutant
  rdf:type owl:Class ;
  rdfs:comment "Pollutant observed as a concentration in air (e.g., PM10, PM2.5)."@en ;
  rdfs:label "Air pollutant"@en ;
  rdfs:subClassOf xemo:Pollutant ;
.
xemo:AlertThreshold
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:ThresholdKind ;
  rdfs:comment "Threshold kind representing a value whose exceedance should trigger an alert and timely response actions."@en ;
  rdfs:label "Alert threshold"@en ;
.
xemo:AveragingPeriod
  rdf:type owl:Class ;
  rdfs:label "Averaging period"@en ;
  rdfs:label "Time window over which observed values are aggregated for threshold evaluation."@en ;
  rdfs:subClassOf time:DurationDescription ;
.
xemo:ConstructionActivity
  rdf:type owl:Class ;
  rdfs:comment "Construction task or operation carried out within a construction area, potentially associated with a pollutant emission generation."@en ;
  rdfs:label "Construction activity"@en ;
  rdfs:subClassOf dtc:Process ;
  rdfs:subClassOf xemo:EmissionSource ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass xsd:dateTime ;
      owl:onProperty dtc:endTime ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass xsd:dateTime ;
      owl:onProperty dtc:startTime ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
      owl:onProperty <https://w3id.org/digitalconstruction/0.5/Processes#hasLocation> ;
    ] ;
.
xemo:ConstructionArea
  rdf:type owl:Class ;
  rdfs:comment "Spatial subdivision of a construction site where one or more construction activities are carried out (e.g., excavation zone, material storage)."@en ;
  rdfs:label "Construction area"@en ;
  rdfs:subClassOf geo:Feature ;
  rdfs:subClassOf xemo:EmissionSource ;
  rdfs:subClassOf bot:Space ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass geo:Geometry ;
      owl:onProperty geo:hasGeometry ;
    ] ;
.
xemo:ConstructionSite
  rdf:type owl:Class ;
  rdfs:comment "Construction project site comprising one or more construction areas."@en ;
  rdfs:label "Construction site"@en ;
  rdfs:subClassOf geo:Feature ;
  rdfs:subClassOf xemo:EmissionSource ;
  rdfs:subClassOf bot:Site ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass geo:Geometry ;
      owl:onProperty geo:hasGeometry ;
    ] ;
.
xemo:DailyAveragingPeriod
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:AveragingPeriod ;
  rdfs:comment "Averaging period of one day."@en ;
  rdfs:label "Daily averaging period"@en ;
  time:days 1 ;
.
xemo:DirectiveEU2024_2881
  rdf:type owl:NamedIndividual ;
  rdf:type prov:Entity ;
.
xemo:EmissionSource
  rdf:type owl:Class ;
  rdfs:comment "A source of pollutant emissions, at different spatial and functional scales (i.e., site, area, activity)."@en ;
  rdfs:label "Emission source"@en ;
  rdfs:subClassOf owl:Thing ;
  rdfs:subClassOf sosa:FeatureOfInterest ;
.
xemo:HourlyAveragingPeriod
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:AveragingPeriod ;
  rdfs:comment "Averaging period of one hour."@en ;
  rdfs:label "Hourly averaging period"@en ;
  time:hours 1 ;
.
xemo:LimitValue
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:ThresholdKind ;
  rdfs:comment "Threshold kind representing a normative or target value that should be complied with under the specified conditions."@en ;
  rdfs:label "Limit value"@en ;
.
xemo:Mean
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:StatisticalMethod ;
  rdfs:comment "Statistical method representing the arithmetic mean of observed values over a specified averaging period."@en ;
  rdfs:label "Mean"@en ;
.
xemo:Noise
  rdf:type owl:Class ;
  rdfs:comment "Pollutant representing acoustic noise levels."@en ;
  rdfs:label "Noise"@en ;
  rdfs:subClassOf xemo:Pollutant ;
.
xemo:PM10
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:AirPollutant ;
  rdfs:comment "Particulate matter with diameter of 10 µm or less, commonly monitored as ambient air mass concentration."@en ;
  rdfs:label "PM10"@en ;
.
xemo:PM10AlertThreshold2030
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:Threshold ;
  prov:wasDerivedFrom xemo:DirectiveEU2024_2881 ;
  xemo:hasAveragingPeriod xemo:DailyAveragingPeriod ;
  xemo:hasQuantityValue xemo:QV_PM10AlertThreshold2030 ;
  xemo:hasStatisticalMethod xemo:Mean ;
  xemo:hasThresholdKind xemo:AlertThreshold ;
  xemo:isThresholdOfPollutant xemo:PM10 ;
.
xemo:PM10DailyLimit2030
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:Threshold ;
  prov:wasDerivedFrom xemo:DirectiveEU2024_2881 ;
  xemo:hasAveragingPeriod xemo:DailyAveragingPeriod ;
  xemo:hasQuantityValue xemo:QV_PM10DailyLimit2030 ;
  xemo:hasStatisticalMethod xemo:Mean ;
  xemo:hasThresholdKind xemo:LimitValue ;
  xemo:isThresholdOfPollutant xemo:PM10 ;
.
xemo:PM2_5
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:AirPollutant ;
  rdfs:comment "Particulate matter with diameter of 2.5 µm or less, commonly monitored as ambient air mass concentration."@en ;
  rdfs:label "PM2.5"@en ;
.
xemo:PM2_5AlertThreshold2030
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:Threshold ;
  prov:wasDerivedFrom xemo:DirectiveEU2024_2881 ;
  xemo:hasAveragingPeriod xemo:DailyAveragingPeriod ;
  xemo:hasQuantityValue xemo:QV_PM2_5AlertThreshold2030 ;
  xemo:hasStatisticalMethod xemo:Mean ;
  xemo:hasThresholdKind xemo:AlertThreshold ;
  xemo:isThresholdOfPollutant xemo:PM2_5 ;
.
xemo:PM2_5DailyLimit2030
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:Threshold ;
  prov:wasDerivedFrom xemo:DirectiveEU2024_2881 ;
  xemo:hasAveragingPeriod xemo:DailyAveragingPeriod ;
  xemo:hasQuantityValue xemo:QV_PM2_5DailyLimit2030 ;
  xemo:hasStatisticalMethod xemo:Mean ;
  xemo:hasThresholdKind xemo:LimitValue ;
  xemo:isThresholdOfPollutant xemo:PM2_5 ;
.
xemo:Pollutant
  rdf:type owl:Class ;
  rdfs:comment "Observable property representing a pollutant or stressor that can be monitored (e.g., PM10, noise)."@en ;
  rdfs:label "Pollutant"@en ;
  rdfs:subClassOf sosa:ObservableProperty ;
.
xemo:QV_PM10AlertThreshold2030
  rdf:type qudt:QuantityValue ;
  rdf:type owl:NamedIndividual ;
  qudt:hasUnit unit:MicroGM-PER-M3 ;
  qudt:numericValue 90 ;
.
xemo:QV_PM10DailyLimit2030
  rdf:type qudt:QuantityValue ;
  rdf:type owl:NamedIndividual ;
  qudt:hasUnit unit:MicroGM-PER-M3 ;
  qudt:numericValue 45 ;
.
xemo:QV_PM2_5AlertThreshold2030
  rdf:type qudt:QuantityValue ;
  rdf:type owl:NamedIndividual ;
  qudt:hasUnit unit:MicroGM-PER-M3 ;
  qudt:numericValue 50 ;
.
xemo:QV_PM2_5DailyLimit2030
  rdf:type qudt:QuantityValue ;
  rdf:type owl:NamedIndividual ;
  qudt:hasUnit unit:MicroGM-PER-M3 ;
  qudt:numericValue 25 ;
.
xemo:StatisticalMethod
  rdf:type owl:Class ;
  rdfs:comment "Statistic used to evaluate observations against a threshold (e.g., mean, max)."@en ;
  rdfs:label "Statistical method"@en ;
.
xemo:TSP
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:AirPollutant ;
  rdfs:comment "Total Suspended Particles (TSP) represent the overall concentration of solid and liquid particles suspended in ambient air (e.g., dust, smoke, soot, aerosols), typically monitored as mass concentration and commonly covering particles up to ~100 µm diameter."@en ;
  rdfs:label "TSP"@en ;
.
xemo:Threshold
  rdf:type owl:Class ;
  rdfs:comment "Normative or operational limit value for an observed pollutant, defined with value, unit, and aggregation criterion."@en ;
  rdfs:label "Threshold"@en ;
  rdfs:subClassOf prov:Entity ;
.
xemo:ThresholdKind
  rdf:type owl:Class ;
  rdfs:comment "Category of threshold."@en ;
  rdfs:label "Threshold kind"@en ;
.
xemo:UrbanRegion
  rdf:type owl:Class ;
  rdfs:comment "Portion of an urban context (e.g., district or neighbourhood)."@en ;
  rdfs:label "Urban region"@en ;
.
xemo:Vibration
  rdf:type owl:Class ;
  rdfs:comment "Pollutant representing vibration levels."@en ;
  rdfs:label "Vibration"@en ;
  rdfs:subClassOf xemo:Pollutant ;
.
xemo:contains
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates an urban region to a construction site located within it."@en ;
  rdfs:domain xemo:UrbanRegion ;
  rdfs:label "contains"@en ;
  rdfs:range xemo:ConstructionSite ;
  owl:inverseOf xemo:isContainedIn ;
.
xemo:emitsPollutant
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates an emission source to a pollutant it emits."@en ;
  rdfs:domain xemo:EmissionSource ;
  rdfs:label "emits pollutant"@en ;
  rdfs:range xemo:Pollutant ;
.
xemo:hasAveragingPeriod
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a threshold to the averaging period used for evaluating observations."@en ;
  rdfs:domain xemo:Threshold ;
  rdfs:label "has averaging period"@en ;
  rdfs:range xemo:AveragingPeriod ;
.
xemo:hasConstructionActivity
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a construction area to a construction activity carried out within it."@en ;
  rdfs:domain xemo:ConstructionArea ;
  rdfs:label "has construction activity"@en ;
  rdfs:range xemo:ConstructionActivity ;
  owl:inverseOf xemo:isConstructionActivityOfArea ;
.
xemo:hasConstructionArea
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a construction site to one of its construction areas."@en ;
  rdfs:domain xemo:ConstructionSite ;
  rdfs:label "has construction area"@en ;
  rdfs:range xemo:ConstructionArea ;
  rdfs:subPropertyOf bot:hasSpace ;
  owl:inverseOf xemo:isConstructionAreaOf ;
.
xemo:hasQuantityValue
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Associates a threshold with its numeric value and unit ."@en ;
  rdfs:domain xemo:Threshold ;
  rdfs:label "has quantity value"@en ;
  rdfs:range qudt:QuantityValue ;
.
xemo:hasStatisticalMethod
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Specifies the statistic used for evaluation (e.g., mean, max)."@en ;
  rdfs:domain xemo:Threshold ;
  rdfs:label "has statistical method"@en ;
  rdfs:range xemo:StatisticalMethod ;
.
xemo:hasThreshold
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a pollutant to a threshold that applies to it."@en ;
  rdfs:domain xemo:Pollutant ;
  rdfs:label "has threshold"@en ;
  rdfs:range xemo:Threshold ;
  owl:inverseOf xemo:isThresholdOfPollutant ;
.
xemo:hasThresholdKind
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Specifies the kind of threshold (e.g., limit value, alert)."@en ;
  rdfs:domain xemo:Threshold ;
  rdfs:label "has threshold kind"@en ;
  rdfs:range xemo:ThresholdKind ;
.
xemo:isConstructionActivityOfArea
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates an activity to the area where it is carried out."@en ;
  rdfs:domain xemo:ConstructionArea ;
  rdfs:label "is construction activity of area"@en ;
  rdfs:range xemo:ConstructionActivity ;
  owl:inverseOf xemo:hasConstructionActivity ;
.
xemo:isConstructionAreaOf
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a construction area to the construction site it belongs to."@en ;
  rdfs:domain xemo:ConstructionArea ;
  rdfs:label "is construction area of"@en ;
  rdfs:range xemo:ConstructionSite ;
.
xemo:isContainedIn
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a construction site to the urban region that contains it."@en ;
  rdfs:label "is contained in"@en ;
.
xemo:isInstalledIn
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Relates a monitoring asset or hosting support to the construction area where it is installed."@en ;
  rdfs:label "is installed in"@en ;
  rdfs:range xemo:ConstructionArea ;
.
xemo:isThresholdOfPollutant
  rdf:type owl:ObjectProperty ;
  rdfs:comment "Links a threshold to the pollutant it applies to."@en ;
  rdfs:domain xemo:Threshold ;
  rdfs:label "is threshold of pollutant"@en ;
  rdfs:range xemo:Pollutant ;
.
demo:Activity_Excavation_01
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:ConstructionActivity ;
.
demo:Activity_Excavation_02
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:ConstructionActivity ;
.
demo:Activity_Roadwork_01
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:ConstructionActivity ;
.
