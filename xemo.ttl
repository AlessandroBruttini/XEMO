  rdf:type xemo:ConstructionArea ;
  geo:hasGeometry [
      geo:asWKT "POLYGON ((13.343191383134 42.3675141313119,13.3432153475282 42.3675409302044,13.3433027016106 42.3675198003084,13.3433078552437 42.36746568716,13.3432645647251 42.3674863016927,13.343254772822 42.3674767674714,13.343191383134 42.3675141313119))"^^geo:wktLiteral ;
    ] ;
  xemo:emitsPollutant xemo:PM10 ;
  xemo:emitsPollutant xemo:PM2_5 ;
  xemo:emitsPollutant xemo:TSP ;
  xemo:hasConstructionActivity demo:Activity_Excavation_01 ;
  xemo:isConstructionAreaOf demo:ConstructionSite_01 ;
.
