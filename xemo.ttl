.
demo:Site_Station_02
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Platform ;
  sosa:hosts demo:Sensor_Airnode_02 ;
  xemo:isInstalledIn demo:ConstructionArea_2 ;
.
demo:Site_Station_03
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Platform ;
  sosa:hosts demo:Sensor_Airnode_03 ;
  xemo:isInstalledIn demo:ConstructionArea_3 ;
.
demo:Station_Via_Amiternum
  rdf:type owl:NamedIndividual ;
  rdf:type sosa:Platform ;
  geo:hasGeometry demo:Location_Via_Amiternum ;
  sosa:hosts demo:Sensor_Airnode_Via_Amiternum ;
.
demo:UrbanRegion_01
  rdf:type owl:NamedIndividual ;
  rdf:type xemo:UrbanRegion ;
.
